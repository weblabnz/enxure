# Everything here is OPTIONAL — `docker compose up -d --build` works with zero
# config (sane built-in defaults, and CRON_SECRET auto-generates itself on first
# boot). Copy this file to .env only once you want to override something —
# most commonly SMTP, since there's no working default for that.

# ── Database ──────────────────────────────────────────────────────────────
# Defaults to enxure/enxure/enxure_default_change_me if unset. The database is
# never exposed outside the Docker network (no host port mapping), so the
# default is low-risk, but change it if you want to be extra safe.
DB_NAME=enxure
DB_USER=enxure
DB_PASSWORD=change-me-to-a-long-random-password
DB_ROOT_PASSWORD=change-me-to-a-different-long-random-password

# ── Cron authentication ──────────────────────────────────────────────────
# Leave this UNSET (recommended) — the app generates a random, unique-per-install
# value on first boot and reuses it from then on. Only set it explicitly if you
# need a specific known value (e.g. `openssl rand -hex 24`). Unlike the DB
# password above, this gates a publicly-reachable URL, so never reuse the same
# value across multiple installs.
# CRON_SECRET=
CRON_SCHEDULE=15 7 3 * *

# ── App ───────────────────────────────────────────────────────────────────
APP_TIMEZONE=UTC
APP_CURRENCY=USD
HTTP_PORT=8090

# ── Email (SMTP) — see INSTALL.md for a Gmail walkthrough ──────────────────
# The app runs fine without these — invoice emails just won't send until set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=enXure
SMTP_ENCRYPTION=tls
